# Copy to .env and fill in. .env is gitignored — never commit real values.

# Discord webhook for job alerts
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...

# Discord bot token for slash commands (/scan /stats /tier /applied /hide)
# Developer Portal -> your app -> Bot -> Reset Token
DISCORD_BOT_TOKEN=

# OpenRouter (free tier, no card) — https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Agnes AI fallback (free tier) — https://platform.agnes-ai.com/
AGNES_API_KEY=

# Reddit API (free app registration) — https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=qa-job-hunter/0.1 by u/YOUR_USERNAME

# Dashboard
JOBHUNT_PORT=8420
JOBHUNT_HOST=127.0.0.1
